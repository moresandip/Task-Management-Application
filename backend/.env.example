# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── OpenWeatherMap ───────────────────────────────────────
# Free API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# ─── Email (Nodemailer via Gmail) ─────────────────────────
# Enable 2FA on your Google account, then create an App Password:
# https://myaccount.google.com/apppasswords
EMAIL_FROM=your_gmail@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

# ─── Frontend URL (for CORS) ──────────────────────────────
CLIENT_URL=http://localhost:5173
